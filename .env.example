# Variabili richieste dalle Vercel Functions in api/ (server-side, da impostare
# nelle Environment Variables del progetto Vercel, non nel frontend).

# Credenziali Basic Auth per le API Datexit / STONE MLM
DATEXIT_API_USER=
DATEXIT_API_PASS=

# Chiave Resend per l'invio email (contatti e richieste di partecipazione).
# Se assente, le funzioni rispondono con un fallback "mailto" lato client.
RESEND_API_KEY=

# Variabile letta dal frontend (richiede prefisso VITE_ per essere esposta
# al bundle browser). Agent ID ElevenLabs per l'assistente vocale/chat.
# Non e' un segreto (va comunque nel bundle JS pubblico), ma tenerlo qui
# evita di riscrivere il codice ad ogni cambio di agente.
VITE_ELEVENLABS_AGENT_ID=agent_3001m5j8gvcrez6asz0dgt6f0b3j
